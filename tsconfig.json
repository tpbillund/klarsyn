{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "moduleDetection": "legacy",
    "rootDir": "src",
    "outDir": "dist",
    "types": [],
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
